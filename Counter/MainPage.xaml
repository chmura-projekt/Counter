<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.MainPage"
             Title="Licznik">

    <ScrollView>
        
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center" HorizontalOptions="Center">
            
            <Label x:Name="NazwaLicznika" Text="Moje liczniki" FontSize="32" HorizontalOptions="Center"/>
            
            <Entry x:Name="NazwaNowegoLicznika" Placeholder="Dodaj nazwę licznika"/>
            
            <Entry x:Name="WartoscPoczatkowa" Placeholder="Podaj wartość początkową licznika." Keyboard="Numeric"/>
            

            <Picker x:Name="KolorNowegoLicznika" Title="Wybierz kolor" SelectedIndex="0">

                <Picker.Items>
                    <x:String>Niebieski</x:String>
                    <x:String>Zielony</x:String>
                    <x:String>Różowy</x:String>
                    <x:String>Żółty</x:String>
                    <x:String>Fioletowy</x:String>
                </Picker.Items>

            </Picker>

            <Button Text="Dodaj licznik" Clicked="DodajLicznik_Clicked"/>

            <VerticalStackLayout x:Name="ListaLicznikow" Spacing="15">

            </VerticalStackLayout>
            
        </VerticalStackLayout>
        
    </ScrollView>

</ContentPage>
